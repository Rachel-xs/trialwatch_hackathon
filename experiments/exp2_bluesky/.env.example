# Copy to .env and fill in. .env is gitignored and must never be printed,
# committed, or echoed into logs, JSON or FINDINGS.md.
# Create an app password at: Bluesky -> Settings -> Privacy and security
# -> App passwords. Never use the account's main password here.
BSKY_HANDLE=yourname.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# X (Twitter) API v2 app-only Bearer token, from the developer portal.
# Recent search needs a paid/enrolled access level; the Free tier returns 403.
# May be pasted URL-encoded; the script decodes it.
X_BEARER_TOKEN=AAAA...
